{
  "name": "@airframes/ads-codegen",
  "version": "0.1.0",
  "description": "Codegen tool for the Airframes Decoder Spec (ADS). Reads spec YAML, emits TypeScript / Rust / C plugin source.",
  "type": "module",
  "bin": {
    "ads-gen": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./interpret": "./dist/interpret.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^12.1.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/airframesio/airframes-decoder.git",
    "directory": "codegen"
  },
  "license": "MIT",
  "keywords": ["acars", "decoder", "dsl", "codegen", "airframes"]
}
